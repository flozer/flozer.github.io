// Script DAX: Listar todas as medidas sem pasta de exibição
// Útil para identificar medidas que precisam ser organizadas
// Execute no DAX Studio ou na Exibição de consulta DAX do Power BI Desktop
// Requer suporte às funções INFO.VIEW (Power BI Desktop a partir de 2024)

EVALUATE
SELECTCOLUMNS(
    FILTER(
        INFO.VIEW.MEASURES(),
        ISBLANK([DisplayFolder]) || [DisplayFolder] = ""
    ),
    "Tabela", [Table],
    "Medida", [Name]
)
ORDER BY [Tabela], [Medida]
