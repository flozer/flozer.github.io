// Script DAX: Linhas, colunas, medidas e maior cardinalidade de cada tabela
// Útil para identificar tabelas grandes e colunas que pesam no modelo
// Execute no DAX Studio ou na Exibição de consulta DAX do Power BI Desktop
// Requer suporte às funções INFO.VIEW e COLUMNSTATISTICS
//
// COLUMNSTATISTICS() traz uma linha "RowNumber-..." por tabela, cuja
// cardinalidade é exatamente o número de linhas da tabela.

EVALUATE
VAR Estatisticas = COLUMNSTATISTICS()
VAR Medidas = INFO.VIEW.MEASURES()
RETURN
    ADDCOLUMNS(
        SELECTCOLUMNS(INFO.VIEW.TABLES(), "Tabela", [Name]),
        "Linhas",
            MAXX(
                FILTER(
                    Estatisticas,
                    [Table Name] = [Tabela] && LEFT([Column Name], 9) = "RowNumber"
                ),
                [Cardinality]
            ),
        "Colunas",
            COUNTROWS(
                FILTER(
                    Estatisticas,
                    [Table Name] = [Tabela] && LEFT([Column Name], 9) <> "RowNumber"
                )
            ),
        "Maior Cardinalidade de Coluna",
            MAXX(
                FILTER(
                    Estatisticas,
                    [Table Name] = [Tabela] && LEFT([Column Name], 9) <> "RowNumber"
                ),
                [Cardinality]
            ),
        "Medidas", COUNTROWS(FILTER(Medidas, [Table] = [Tabela]))
    )
ORDER BY [Linhas] DESC
